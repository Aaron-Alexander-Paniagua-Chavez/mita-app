# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Para desarrollo, root puede crear la base en el primer inicio. En una
# instalación real usa una cuenta MySQL dedicada con permisos sólo sobre
# SistemaGeriatrico, creada previamente por el administrador de la base.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=SistemaGeriatrico
MYSQL_USER=mita_app
MYSQL_PASSWORD=coloca_una_contrasena_fuerte

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=mita_analytics
