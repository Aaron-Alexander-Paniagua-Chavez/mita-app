# Copia este archivo como .env sólo en tu computadora. No subas .env al repositorio.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mita_local
MYSQL_USER=root
MYSQL_PASSWORD=
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=mita_analytics

# Capacidades remotas opcionales: deja vacío para un funcionamiento totalmente local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MQTT_HOST=
MQTT_PORT=8883
MQTT_TOPIC=
MQTT_TLS=1

# Sólo para cargar datos de demostración mediante el panel de administrador.
MITA_DEMO_PASSWORD=
