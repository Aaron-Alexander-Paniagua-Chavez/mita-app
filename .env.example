# Copia este archivo como .env sólo en tu computadora. No subas .env al repositorio.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=SistemaGeriatrico
MYSQL_USER=root
MYSQL_PASSWORD=

# MongoDB es opcional y no guarda datos clínicos ni de usuarios.
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=mita_analytics

# Capacidades remotas opcionales: lascia vacío para un funcionamiento totalmente local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MQTT_HOST=
MQTT_PORT=8883
MQTT_TOPIC=
MQTT_TLS=1

# Sólo para cargar datos de demostración mediante el panel de administrador.
MITA_DEMO_PASSWORD=